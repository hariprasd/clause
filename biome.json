{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "packages/**",
      "!packages/capture/background.js",
      "!packages/capture/capture.js",
      "!packages/capture/frames.js",
      "!packages/capture/options.js",
      "!packages/capture/server.js",
      "!packages/capture/shortcut.js",
      "!packages/capture/*.html",
      "!packages/capture/*.json",
      "!packages/capture/*.md",
      "!packages/capture/vendor/*.md",
      "!**/node_modules/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/capture/vendor/patches.mjs"],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "suspicious": { "noTemplateCurlyInString": "off" }
        }
      }
    }
  ]
}
